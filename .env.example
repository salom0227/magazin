# ---- Required ----

# PostgreSQL (Neon, Supabase, local Docker, ...)
DATABASE_URL=postgresql://user:password@host:5432/magazin?schema=public

# Secret used to sign auth tokens. The server refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# ---- Optional server settings ----
PORT=3000
DELIVERY_FEE=25000
FREE_DELIVERY_THRESHOLD=500000

# Seed credentials (only used by `npm run prisma:seed`)
SEED_ADMIN_PIN=1234
SEED_USER_PIN=1234

# ---- Cloudflare R2 (image uploads) ----
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=your_bucket_name
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# Public read URL of the bucket (r2.dev subdomain or custom domain).
# The S3 API endpoint above is NOT publicly readable, so this is required for uploads.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---- Telegram order notifications (optional) ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ---- Misc ----
APP_URL=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key_here
